menu "MQTT Configuration"

    config MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://broker.emqx.io:1883"
        help
            URI of the MQTT broker to connect to.
            Format: mqtt://broker_host:port or mqtts://broker_host:port for SSL
            Examples:
            - mqtt://broker.emqx.io:1883
            - mqtts://broker.emqx.io:8884
            - mqtt://192.168.1.100:1883

    config MQTT_KEEPALIVE
        int "MQTT Keep Alive interval (seconds)"
        default 60
        range 10 300
        help
            Keep-alive interval for MQTT connection

endmenu
